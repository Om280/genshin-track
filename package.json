{
  "name": "genshin-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/browser-smoke.mjs",
    "workflow": "node tests/browser-workflow.mjs",
    "guide:coverage": "node build_guide_queue.mjs",
    "guide:browser": "node tests/browser-guide-coverage.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "playwright": "^1.63.0"
  }
}
